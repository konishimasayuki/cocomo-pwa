# Upstash Redis (REST API) - Upstashのダッシュボードからコピー
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxx

# ログインパスワードのSHA-256ハッシュ（省略時はコード内の既定ハッシュ=「0524」が使われる）
# 変更したい場合は下記のコマンドで新パスワードのハッシュを作って設定してください
#   node -e "crypto.subtle.digest('SHA-256', new TextEncoder().encode('新パスワード')).then(b=>console.log(Buffer.from(b).toString('hex')))"
# APP_PASSWORD_HASH=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
